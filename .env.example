# Copy to project .env. Existing process variables override these Baidu settings.
BUBBLE_WEB_ENABLED=false
BAIDU_API_KEY=
BAIDU_FREE_RESOURCES_CONFIRMED=false
BAIDU_LOCAL_DAILY_LIMIT=30
BAIDU_TEST_MODE=true
BAIDU_TEST_LIMIT=2
